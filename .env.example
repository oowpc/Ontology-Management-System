# 数据库连接串；切 PostgreSQL 例：postgresql+psycopg://user:pass@host:5432/ontology
DB_URL=sqlite:///data/ontology.db
# 会话签名密钥。注意：不设置时用的是代码兜底值 dev-secret-change-me，
# 此时必须显式 DEV_MODE=1 才能启动（P0 防兜底密钥上生产）；改成任何非默认值即可正常启动
SECRET_KEY=change-me-in-production
# DEV_MODE=1
# CSRF 表单校验（同步器 token，base.html 自动注入隐藏域；Bearer 调用免校），0=关闭
# CSRF_ENABLED=1
# 登录防爆破：连续失败 5 次锁 600 秒（按用户名，进程内存计数）
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_SECONDS=600
# 是否写入演示数据（概念/算子/使用统计），0=只建账号
SEED_DEMO=1
# 查重阈值：>= 硬拦截（阻止直接入库）；>= 提示相似
SIMILARITY_BLOCK_THRESHOLD=0.95
SIMILARITY_SUGGEST_THRESHOLD=0.75
# 体检：单概念绑定算子数超过该值视为「过多」候选
HEALTH_OPERATOR_MAX=15
# 体检定时任务 cron（分 时 日 月 周）
HEALTH_CRON=30 3 * * *
# 体检「孤立节点」白名单（根概念，逗号分隔）
ROOT_CONCEPTS=机构,行政区划,人,职务,民族,职责

# LLM（OpenAI 兼容端点；留空则「语义复核 / 审核建议」自动隐藏，系统照常可用）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=45

# M7 · KE 标注进度
# 项目截止日：燃尽理想线终点 / 预计完成日健康度基准
KE_DEADLINE=2026-11-15
# 是否向「一组」灌入示例标注数据（ke_tasks 非空则自动跳过），0=不灌
SEED_KE=1

# M11 · 通用性（别家工况不改代码，JSON 单项覆盖默认即可）
# CSV 表头映射：KE_COLUMN_MAP={"id":"题目编号","status":"状态"}
# 状态写法映射：KE_STATUS_MAP={"done":["已完成","done"]}
# GOLD 篇级阶段流水线（首次建库前设定，CHECK 约束随之定型）：
# GOLD_STAGES=[["co_annotation","CO 标注与对齐"],["co_merge","大本体整理"],["ke_annotation","KE 标注与对齐"],["done","已完成"]]
# 泳道时段：GOLD_SLOTS=["上午","下午"]
# M20 定稿强校验：1=结构错误阻断 reviewed→gold（0=关闭门槛，校验仍可见）
# GOLD_FINALIZE_VALIDATE=1
# 统一校验：0=只记录结果（默认）；1=rule/operator/GOLD error 阻断写入
# VALIDATION_ENFORCE=0

# M25/M26 · KEOL 桥接：政府本体库源目录（sync_keol.py / gold_to_keol.py 的默认 --src）
# KEOL_SRC=C:\Users\wang\Desktop\工作项目\本体与政务\政府本体
# KEOL 本体源持续检查（只记录差异；推送仍需 OMS 审批）
KEOL_ONTOLOGY_PATH=/home/oowpc/KEOL/console/data/ontology.json
KEOL_SYNC_LIBRARY=keol-yuer
# KEOL_SYNC_CRON=0 * * * *
# 需要「提交建议推送」时，OMS 服务端还要配置 KEOL_CONSOLE_TOKEN


# KE-matcher 等价校验（可选）
KE_MATCHER_BASE_URL=http://127.0.0.1:8082
# 本地 keval（Syntastic_and_Lexical-Verifier）checkout
KE_MATCHER_KEVAL_PATH=/home/oowpc/Syntastic_and_Lexical-Verifier
KE_MATCHER_TIMEOUT=65


# DataMaker 数据生成
DATAMAKER_DIR=/home/oowpc/datamaker
DATAMAKER_PYTHON=/home/oowpc/datamaker/.venv/bin/python
DATAMAKER_WORK_ROOT=/home/oowpc/Ontology-Management-System/data/datamaker
DATAMAKER_LLM_BASE_URL=https://api.deepseek.com/v1
DATAMAKER_LLM_API_KEY=replace-me
DATAMAKER_LLM_MODEL=deepseek-v4-flash
DATAMAKER_MODELS=deepseek-v4-flash
DATAMAKER_KE2SQL_PATH=/home/oowpc/ke2sql-v031
DATAMAKER_VERIFIER_PATH=/home/oowpc/Syntastic_and_Lexical-Verifier
DATAMAKER_Z3_PATH=/home/oowpc/KE-matcher
DATAMAKER_SERVICE_URL=http://127.0.0.1:8081
DATAMAKER_MAX_ACTIVE=1
# DataMaker 成功后是否自动生成 GOLD 草稿（只建 draft，仍需人工审查）
DATAMAKER_AUTO_GOLD=1
# auto=有 gold_eval.json 就按 gate 拦截；require=无报告也拦截；off=不检查
# DATAMAKER_GOLD_GATE_MODE=auto
# DATAMAKER_GOLD_GATE_FILE=gold_eval.json
DATAMAKER_TIMEOUT=7200

# OMS KE 语法校验（Syntastic_and_Lexical-Verifier）
KE_FORM_VALIDATOR_PATH=/home/oowpc/Syntastic_and_Lexical-Verifier

# DataAgent Monitor（独立只读监控服务）
# DATAAGENT_MONITOR_URL=http://127.0.0.1:8765
# DATAAGENT_MONITOR_TIMEOUT=8
# 远程 Webhook 必填；本机 127.0.0.1 可不填，仅接受 loopback
# DATAAGENT_MONITOR_WEBHOOK_TOKEN=change-me

# DataMaker 原生 Job API（设置后 OMS 新任务交给 DataMaker API + worker）
# DATAMAKER_NATIVE_API_URL=http://127.0.0.1:8093
# DATAMAKER_NATIVE_API_TOKEN=
# DATAMAKER_NATIVE_API_TIMEOUT=10
